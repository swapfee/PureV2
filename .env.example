# PureV2 environment template — never put real secrets in this file.
# Copy to `.env` on the VPS and fill in production values.
# Restrict permissions: chmod 600 .env

NODE_ENV=production
LOG_LEVEL=info

# Coordinator-only Discord bot token. Workers never receive this value.
# Use a dedicated development/test bot for initial guild testing; do not reuse
# a different production bot's token across environments.
DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_APPLICATION_ID=000000000000000000

# Atlas MongoDB URI (TLS via mongodb+srv). Use a separate production database.
# The path after the host is the database name — use /purev2 (NOT /test).
# Never commit the real URI. Rotate credentials if exposed.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/purev2?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=3
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000

# Private disposable Redis cache. Compose provides this hostname and publishes no Redis port.
# MongoDB remains authoritative if Redis restarts.
REDIS_URL=redis://redis:6379
VOICE_STATS_CHECKPOINT_INTERVAL_MS=300000

# Start with one worker. A second worker partitions shards; it does not create
# additional Discord Gateway shards by itself.
BOT_WORKER_COUNT=1

WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEARTBEAT_TIMEOUT_MS=15000
WORKER_RESTART_BASE_DELAY_MS=1000
WORKER_RESTART_MAX_DELAY_MS=30000
WORKER_EVENT_ACK_TIMEOUT_MS=30000
WORKER_EVENT_BUFFER_LIMIT=1000
WORKER_EVENT_MAX_ATTEMPTS=3
WORKER_EVENT_DEDUP_LIMIT=5000
WORKER_EVENT_DEDUP_TTL_MS=300000

# Inside Docker, bind health on all interfaces. Compose publishes ONLY to host loopback:
#   127.0.0.1:3000:3000
# Do not expose port 3000 publicly on the VPS firewall.
HEALTH_HOST=0.0.0.0
HEALTH_PORT=3000

# REST proxy must remain loopback-only and must NEVER be published by Docker.
REST_PROXY_HOST=127.0.0.1
REST_PROXY_PORT=8081
# Generate with: openssl rand -hex 32
REST_PROXY_AUTHORIZATION=replace-with-openssl-rand-hex-32
# Allows one validated voice-stats PNG plus multipart overhead.
REST_PROXY_BODY_LIMIT_BYTES=4194304
REST_REQUEST_CACHE_LIMIT=5000
REST_REQUEST_CACHE_TTL_MS=300000

SHUTDOWN_TIMEOUT_MS=30000
